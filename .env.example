# Base de datos SQLite (local, no requiere instalar nada)
# Para producción, cambiar a PostgreSQL: postgresql://usuario:password@localhost:5432/estudiantes_abogacia
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secreto-con: openssl rand -base64 32"

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI API
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
